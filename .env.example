# Skopiuj ten plik jako .env. Nigdy nie commituj prawdziwych sekretów.
# Kreator pierwszej instalacji (bez logowania): npm run setup
# W działającej platformie: Studio → Generator .env.
# Kreator tworzy JSON repozytoriów; nie musisz pisać go ręcznie.
# Instrukcja migracji, wiele repozytoriów i testy: GITEA_SETUP.md.
GIT_PROVIDER=gitea
GITEA_BASE_URL=
GITEA_API_URL=
GITEA_TOKEN=
GITEA_OWNER=
GITEA_REPO=
GITEA_BRANCH=main
GITEA_CONTENT_ROOT=
# Opcjonalna lista JSON; zastępuje pojedyncze GITEA_OWNER / GITEA_REPO.
# W tokenEnv wpisz nazwę zmiennej, NIGDY wartość tokenu.
GITEA_CONTENT_REPOSITORIES=
# Osobne PUBLICZNE repo: właściciel/nazwa. Nie udostępniaj repo kursów.
GITEA_SITE_ASSETS_REPOSITORY=
GITEA_SITE_ASSETS_BRANCH=
GITEA_SITE_ASSETS_DIRECTORY=
# Opcjonalny osobny token; puste używa GITEA_TOKEN.
GITEA_SITE_ASSETS_TOKEN=
# Początkowa ścieżka JSON w repo publicznym; później można zmienić ją w panelu.
LANDING_CONFIG_PATH=landing/config.json

# Opcjonalne konfiguracje ENV widoczne w Studio → Konfiguracja AI.
# Można przypisać je do czatu także wtedy, gdy istnieją konfiguracje zapisane w panelu.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Poniższe zmienne działają po wybraniu GIT_PROVIDER=github.
# Fine-grained token tylko do wybranych repo materiałów: Repository permissions → Contents: Read and write.
GITHUB_CONTENT_TOKEN=
# Opcjonalna lista wielu repo; gdy jest ustawiona, zastępuje trzy ustawienia pojedynczego repo poniżej.
GITHUB_CONTENT_REPOSITORIES=
GITHUB_CONTENT_REPOSITORY=
GITHUB_CONTENT_REF=main
GITHUB_CONTENT_ROOT=
# Osobny, publiczny magazyn logo, favicon, obrazów i statycznej konfiguracji landingu:
# Puste repo/ref zachowują dotychczasowe Kuczis-Media/logo@main.
# landing/route.json zawiera ustawienia źródła. Nie umieszczaj tam sekretów.
# Docelowe repozytorium/gałąź/plik JSON i zewnętrzną domenę wybierz w Studio → Publikacja strony.
# Wymagany do publikacji w trybie GitHub. Tryb Netlify Blobs używa SITE_ID i NETLIFY_API_TOKEN.
# Ustawienia źródła korzystają z istniejącej Function i cache CDN/przeglądarki (5 min).
# Bez tokenu GitHuba można publikować do Blobs albo pobrać samodzielny HTML bez backendu.
# Cennik wczytuje się automatycznie; ceny i płatności mają osobne wywołania Functions.
# Token fine-grained wymaga Contents: Read and write do repo ustawień oraz wybranego repo JSON.
GITHUB_SITE_ASSETS_TOKEN=
GITHUB_SITE_ASSETS_REPOSITORY=
GITHUB_SITE_ASSETS_REF=
# Pusty katalog oznacza katalog główny; można wpisać np. branding.
GITHUB_SITE_ASSETS_DIRECTORY=
# Wymagane przez silnie spójne Blobs: progress, egzaminy, płatności,
# konfiguracje/usage AI, aktywny dashboard oraz draft/publikację landing page.
NETLIFY_API_TOKEN=
# Netlify ustawia SITE_ID na deployu automatycznie; lokalnie wpisz UUID witryny.
SITE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
